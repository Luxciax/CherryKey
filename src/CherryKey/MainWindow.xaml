<Window x:Class="CherryKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CherryKey" Icon="Assets/CherryKey.ico"
        Width="1280" Height="780" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- v0.4 title bar -->
            <Border Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource AccentGradient}">
                            <Image Source="Assets/CherryKey.png" Stretch="Uniform" Margin="4"/>
                        </Border>
                        <TextBlock Text="CherryKey" FontSize="18" FontWeight="SemiBold" Margin="10,0,9,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Pill}" Padding="8,3"><TextBlock Text="v0.4.0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                    </StackPanel>
                    <Button Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click"/>
                    <Button Grid.Column="2" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource WindowButton}" Content="□" Click="Maximize_Click"/>
                    <Button Grid.Column="3" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource WindowButton}" Content="×" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/><ColumnDefinition Width="276"/></Grid.ColumnDefinitions>

                <!-- Provider sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                        <Grid Margin="14,13,14,12">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="⌕" FontSize="18" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="搜索供应商 / 模型 / 备注…" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="37,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" IsHitTestVisible="False">
                                <TextBlock Text="Ctrl K" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="17,0">
                            <TextBlock Text="供应商列表" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ProviderCountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding ProvidersView}" SelectedItem="{Binding SelectedProvider}"
                                     ItemContainerStyle="{StaticResource ProviderItem}" Background="Transparent" BorderThickness="0"
                                     Margin="10,0,7,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{Binding AvatarBrush}" BorderBrush="#44FFFFFF" BorderThickness="1">
                                            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,-1,6,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProtocolDisplay}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PrimaryModelId}" Foreground="{DynamicResource MutedDarkBrush}" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0">
                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource MutedDarkBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProviderCountText}" Value="共 0 个供应商"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="⌕" FontSize="28" Foreground="{DynamicResource MutedDarkBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="尚未读取到供应商" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <TextBlock Text="支持 v1 LevelDB 与 v2 SQLite" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Grid Margin="14,0">
                                <TextBlock Text="{Binding ProviderCountText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="ToggleTheme_Click" ToolTip="切换亮色/暗色">
                                        <TextBlock x:Name="ThemeGlyph" Text="☼" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding RescanDatabaseCommand}" Content="⚙" Margin="6,0,0,0" ToolTip="重新扫描数据源"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main content -->
                <Border Grid.Column="1" Background="{DynamicResource WindowBrush}">
                    <Grid Margin="16,14,16,0">
                        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="108"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                        <Border Background="{DynamicResource HeaderGlowGradient}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="{DynamicResource SuccessDarkBrush}" CornerRadius="11">
                                    <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Pill}" Margin="7,0,0,0" Padding="7,2"><TextBlock Text="{Binding ConnectionBadgeText}" Foreground="{DynamicResource SuccessBrush}" FontSize="9"/></Border>
                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Padding="7,2"><TextBlock Text="{Binding DataSourceTypeText}" Foreground="{DynamicResource AccentLightBrush}" FontSize="9"/></Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DatabaseDisplayPath}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RescanDatabaseCommand}" Content="↻  重新扫描" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ChooseDatabaseCommand}" Content="▰  选择数据源"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="4,16,4,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" Background="{Binding SelectedProvider.AvatarBrush}" CornerRadius="13" VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedProvider.Initial, TargetNullValue=·}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedProvider.Name, TargetNullValue=请选择供应商}" FontSize="22" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Style="{StaticResource Pill}" Padding="7,2"><TextBlock Text="{Binding SelectedProvider.ProtocolDisplay, TargetNullValue=等待数据源}" Foreground="{DynamicResource AccentLightBrush}" FontSize="9"/></Border>
                                    <Border Style="{StaticResource Pill}" Padding="7,2" Margin="6,0,0,0"><TextBlock Text="{Binding SelectedProvider.StatusText, TargetNullValue=未连接}" Foreground="{DynamicResource SuccessBrush}" FontSize="9"/></Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedProvider.Id, TargetNullValue=Cherry Studio 配置将显示在这里}" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource MutedBrush}" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top" Padding="9,5"><TextBlock Text="来自 Cherry · 只读导入" Foreground="{DynamicResource MutedBrush}" FontSize="9"/></Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <TabControl>
                                <TabItem Header="▣  基本信息">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,3,0">
                                        <Border Style="{StaticResource Card}" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1"><TextBlock Text="供应商名称" Foreground="{DynamicResource MutedBrush}" Margin="16,0" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedProvider.Name}" Margin="14,0" VerticalAlignment="Center"/>
                                                <Border Grid.Row="1" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1"><TextBlock Text="协议类型" Foreground="{DynamicResource MutedBrush}" Margin="16,0" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedProvider.ProtocolDisplay}" Margin="14,0" VerticalAlignment="Center"/>
                                                <Border Grid.Row="2" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1"><TextBlock Text="Base URL" Foreground="{DynamicResource MutedBrush}" Margin="16,0" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProvider.BaseUrlDisplay}" FontFamily="Cascadia Code, Consolas" FontSize="11" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding CopyBaseUrlCommand}" Content="▣" Margin="0,0,6,0"/>
                                                <Border Grid.Row="3" Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><TextBlock Text="状态" Foreground="{DynamicResource MutedBrush}" Margin="16,0" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SelectedProvider.StatusText}" Foreground="{DynamicResource SuccessBrush}" Margin="14,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem>
                                    <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="◇  模型列表"/><Border Style="{StaticResource Pill}" Margin="7,0,0,0" Padding="5,1"><TextBlock Text="{Binding SelectedProvider.ModelCountText, TargetNullValue=0}" FontSize="8"/></Border></StackPanel></TabItem.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,3,0">
                                        <ItemsControl ItemsSource="{Binding SelectedProvider.Models}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Style="{StaticResource CompactCard}"><Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="68"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding EndpointTypes}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding DataContext.CopyModelItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Content="▣"/>
                                            </Grid></Border>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem>
                                    <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⚿  API Key"/><Border Style="{StaticResource Pill}" Margin="7,0,0,0" Padding="5,1"><TextBlock Text="{Binding SelectedProvider.KeyCountText, TargetNullValue=0}" FontSize="8"/></Border></StackPanel></TabItem.Header>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,3,0">
                                        <ItemsControl ItemsSource="{Binding SelectedProvider.ApiKeys}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Style="{StaticResource CompactCard}"><Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding DisplayKey}" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ToggleApiKeyItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Content="{Binding RevealButtonText}" Margin="8,0,0,0"/>
                                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.CopyApiKeyItemCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Content="复制" Margin="7,0,0,0"/>
                                            </Grid></Border>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="▤  备注">
                                    <Border Style="{StaticResource Card}" Margin="0,14,3,0"><TextBlock Text="{Binding SelectedProvider.Notes, TargetNullValue=暂无备注}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                                </TabItem>
                            </TabControl>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Margin="0,14,3,10">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProvider}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🍒" FontSize="30" HorizontalAlignment="Center"/>
                                    <TextBlock Text="正在等待 Cherry Studio 数据" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,5"/>
                                    <TextBlock Text="未自动发现时可重新扫描或手动选择数据源" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RescanDatabaseCommand}" Content="重新自动扫描" Margin="0,13,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" Margin="3,0">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="只读 · 本地处理" Foreground="{DynamicResource SuccessBrush}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Action sidebar -->
                <Border Grid.Column="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14">
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="快速复制" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyKeyCommand}" Content="⚿   复制 API Key" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyBaseUrlCommand}" Content="⛓   复制 Base URL" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyModelCommand}" Content="◇   复制模型 ID" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CopyAllCommand}" Content="▣   复制全部信息" HorizontalContentAlignment="Left"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="复制为" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyClaudeCommand}" Content="〉_   Claude Code 环境变量" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyOpenAiCommand}" Content="◎   OpenAI 环境变量" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyGeminiCommand}" Content="✦   Gemini CLI 配置" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyCodexCommand}" Content="▣   Codex 配置（TOML）" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenCustomTemplateCommand}" Content="&lt;/&gt;   自定义模板" HorizontalContentAlignment="Left"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="导出" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportJsonCommand}" Content="⇩   导出为 JSON" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportMarkdownCommand}" Content="⇩   导出为 Markdown" HorizontalContentAlignment="Left"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="安全状态" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                <TextBlock Text="• 只读访问 Cherry Studio 数据" Foreground="{DynamicResource SuccessBrush}" FontSize="10" Margin="0,0,0,6"/>
                                <TextBlock Text="• 界面默认隐藏完整 API Key" Foreground="{DynamicResource SuccessBrush}" FontSize="10" Margin="0,0,0,6"/>
                                <TextBlock Text="• 剪贴板内容 30 秒后清除" Foreground="{DynamicResource SuccessBrush}" FontSize="10"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
