<Window x:Class="CherryKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CherryKey"
        Width="1440" Height="900"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="7"
                            CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#0D141E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="31" Height="31" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="🍒" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CherryKey" FontSize="20" FontWeight="SemiBold" Margin="11,0,9,0" VerticalAlignment="Center"/>
                    <Border Background="#252F3C" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="v0.1.0" Foreground="#BBC6D4" FontSize="11"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0"
                        Content="—" Click="Minimize_Click"/>
                <Button Grid.Column="2" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0"
                        Content="□" Click="Maximize_Click"/>
                <Button Grid.Column="3" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0"
                        Content="×" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Background="#101824">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="18,15">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="38,10,85,10"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedBrush}"
                               Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                            Background="#253041" BorderBrush="#435168" BorderThickness="1"
                            CornerRadius="6" Padding="7,2" IsHitTestVisible="False">
                        <TextBlock Text="Ctrl + K" FontSize="11" Foreground="#B7C1CE"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="#173326" CornerRadius="10" VerticalAlignment="Center">
                        <Ellipse Width="13" Height="13" Fill="{StaticResource SuccessBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DatabasePath}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                            Content="↻  刷新" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ChooseDatabaseCommand}"
                            Content="⚙  选择数据库"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Provider list -->
            <Border Grid.Column="0" Background="#0E1621" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="17">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="供应商列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="{StaticResource AccentBrush}"
                                Width="34" Height="34" CornerRadius="8" ToolTip="只读模式：请在 Cherry Studio 添加">
                            <TextBlock Text="＋" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ProvidersView}"
                             SelectedItem="{Binding SelectedProvider}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="10"
                                            Background="#3A286F" BorderBrush="#7654D5" BorderThickness="1">
                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ProtocolDisplay}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModelSummary}" Foreground="#8290A2"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="10" Height="10"
                                             Fill="{StaticResource SuccessBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Details -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedProvider.Name, TargetNullValue=请选择供应商}"
                                       FontSize="25" FontWeight="SemiBold"/>
                            <Border Background="#34245C" BorderBrush="#59408D" BorderThickness="1"
                                    CornerRadius="13" Padding="9,4" Margin="12,0,0,0">
                                <TextBlock Text="{Binding SelectedProvider.ProtocolDisplay}" Foreground="#C9ADFF" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="只读" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <TabControl Grid.Row="1">
                        <TabItem Header="▣  基本信息">
                            <StackPanel Margin="0,14,0,0">
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="44"/>
                                            <RowDefinition Height="54"/>
                                            <RowDefinition Height="44"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="供应商名称" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedProvider.Name}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Text="协议类型" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProvider.ProtocolDisplay}" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Text="Base URL" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProvider.BaseUrlDisplay}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}"
                                                Command="{Binding CopyBaseUrlCommand}" Content="▣" ToolTip="复制 Base URL"/>

                                        <TextBlock Grid.Row="3" Text="状态" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProvider.StatusText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="API Key" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding SelectedProvider.KeySummary}"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </Grid>

                                        <ComboBox ItemsSource="{Binding SelectedProvider.ApiKeys}"
                                                  SelectedItem="{Binding SelectedProvider.SelectedApiKey}"
                                                  Margin="0,0,0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#111A25" BorderBrush="#334154" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,10">
                                                <TextBlock Text="{Binding SelectedProvider.SelectedApiKey.DisplayKey}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding ToggleKeyCommand}"
                                                    Content="{Binding SelectedProvider.SelectedApiKey.RevealButtonText}"
                                                    Margin="9,0,0,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding CopyKeyCommand}" Content="复制"
                                                    Margin="9,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="认证类型" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedProvider.AuthType, TargetNullValue=未记录}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Text="Header" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProvider.AuthHeader, TargetNullValue=未记录}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Text="前缀" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProvider.AuthPrefix, TargetNullValue=无}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="⌘  模型列表">
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="当前复制模型" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding SelectedProvider.Models}"
                                                  SelectedItem="{Binding SelectedProvider.SelectedModel}"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                Command="{Binding CopyModelCommand}" Content="▣" Margin="9,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ListView Grid.Row="1" ItemsSource="{Binding SelectedProvider.Models}"
                                          SelectedItem="{Binding SelectedProvider.SelectedModel}"
                                          Background="Transparent" BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding EndpointTypes}"
                                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </TabItem>

                        <TabItem Header="⚿  API Key">
                            <ListView Margin="0,14,0,0" ItemsSource="{Binding SelectedProvider.ApiKeys}"
                                      SelectedItem="{Binding SelectedProvider.SelectedApiKey}"
                                      Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayKey}" FontFamily="Cascadia Mono, Consolas"
                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabItem>

                        <TabItem Header="▤  备注">
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <TextBlock Text="{Binding SelectedProvider.Notes, TargetNullValue=暂无备注}"
                                           TextWrapping="Wrap" Foreground="#C7D0DC"/>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </ScrollViewer>

            <!-- Actions -->
            <Border Grid.Column="2" Background="#0E1621" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="快速复制" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyKeyCommand}"
                                        Content="⚿  复制 API Key" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyBaseUrlCommand}"
                                        Content="🔗  复制 Base URL" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyModelCommand}"
                                        Content="◇  复制模型 ID" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CopyAllCommand}"
                                        Content="▣  复制全部信息" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="复制为…" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyClaudeCommand}"
                                        Content="〉_  Claude Code 环境变量" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyOpenAiCommand}"
                                        Content="◎  OpenAI 环境变量" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyGeminiCommand}"
                                        Content="✦  Gemini CLI 配置" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyCodexCommand}"
                                        Content="▣  Codex 配置（TOML）" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenCustomTemplateCommand}"
                                        Content="&lt;/&gt;  自定义模板" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="导出" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportJsonCommand}"
                                        Content="⇩  导出为 JSON" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportMarkdownCommand}"
                                        Content="⇩  导出为 Markdown" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#151F2C" BorderBrush="#2D3A4D" BorderThickness="1"
                                CornerRadius="10" Padding="13">
                            <StackPanel>
                                <TextBlock Text="安全状态" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="• SQLite 只读连接" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• 不保存第二份 API Key" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="• 剪贴板 30 秒自动清除" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#0D141E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}">
                    <Run Text="最后刷新："/>
                    <Run Text="{Binding LastRefreshText}"/>
                    <Run Text="　"/>
                    <Run Text="↻ 自动刷新已开启" Foreground="{StaticResource SuccessBrush}"/>
                </TextBlock>
                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Text="快捷键：Ctrl + Shift + K"/>
            </Grid>
        </Border>
    </Grid>
</Window>
